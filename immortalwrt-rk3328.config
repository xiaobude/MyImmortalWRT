# ========================================
# ImmortalWrt NanoPi R2S 精简版配置
# Target: Rockchip RK3328 / FriendlyElec NanoPi R2S (1GB RAM)
# 插件: LuCI 简体中文, OpenClash, Tailscale/WireGuard, ttyd
# ========================================

# 目标架构与板型 (RK3328 属 armv8 子目标)
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

# 镜像格式 (SquashFS + Ext4 双生成, gzip 压缩)
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 基础工具与证书 (dropbear 与 firewall4/nftables 属目标 DEFAULT_PACKAGES, 不重复声明;
# ca-certificates 与 ca-bundle 都装容易在 rootfs 装配阶段冲突, 只留 ca-bundle)
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_unzip=y

# Web 界面 (LuCI + Lua 兼容层 + 简体中文)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# 防火墙不在这里显式声明: firewall4 与 nftables 是目标的 DEFAULT_PACKAGES,
# 显式重复声明只会多出与上次成功构建不一致的变量

# 1. 代理分流: OpenClash (v0.47.075, 来自 ImmortalWrt luci feed, 无需第三方仓库)
CONFIG_PACKAGE_luci-app-openclash=y

# 2. 异地组网: Tailscale + WireGuard
#    注意: ImmortalWrt v25.12.1 的 luci feed 里没有 luci-app-tailscale,
#    只有命令行版, 需通过 /usr/bin/tailscale 或 luci-turbo 手动配置
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# 3. 网页终端: ttyd
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# 1GB 内存瘦身: 明确不打包的重组件
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_python3=n
