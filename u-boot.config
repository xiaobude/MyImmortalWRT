# MyOpenWRT - U-Boot 配置（RK3568）
# ========================================

CONFIG_ARM=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_RK3568=y
CONFIG_SYS_TEXT_BASE=0x44a00000
CONFIG_NR_DRAM_BANKS=1
CONFIG_SYS_MAX_RAM=1073741824
CONFIG_ENV_OFFSET=0x3f800000
CONFIG_DEFAULT_FDT_FILE="rk3568-evb-v11a.dtb"

# 网络支持
CONFIG_NET=y
CONFIG_ETH_DESIGNWARE=y
CONFIG_RGMII=y
CONFIG_GMAC_RK=y

# 串口控制台
CONFIG_SERIAL_CONS_INDEX=0
CONFIG_ROCKCHIP_SFC=y

# 设备树
CONFIG_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_GPIO=y
CONFIG_OF_MDIO=y
CONFIG_OF_NET=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_OF_UNFLATTEN_HOLES=y
CONFIG_OF_DYNAMIC=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EMBED=y
CONFIG_OF_SMBUS=y
CONFIG_OF_PCI=y
CONFIG_OF_I2C=y

# 中断控制器
CONFIG_GIC=y
CONFIG_ARM_GIC_V3=y

# 时钟控制器
CONFIG_CLK=y
CONFIG_COMMON_CLK=y
CONFIG_ROCKCHIP_COMMON_CLK=y

# 复位控制器
CONFIG_RESET_CONTROLLER=y
CONFIG_ROCKCHIP_PWD=y
CONFIG_ROCKCHIP_RSTC=y

# 电源管理
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_ROCKCHIP_PMD=y

# 内存管理
CONFIG_SPL_STACK_R=y
CONFIG_SPL_STACK_R_MALLOC_SIMPLE_LEN=0x100000
CONFIG_SYS_MMAP_UPDATES_USED=y
CONFIG_MTD=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_ECC=y
CONFIG_MTD_NAND_ECC_SOFT=y
CONFIG_MTD_NAND_RK3288=y

# 存储
CONFIG_SDCARD=y
CONFIG_ROCKCHIP_SDHCI=y
CONFIG_SPI_FLASH=y
CONFIG_SF_DEFAULT_SPEED=80000000
CONFIG_SF_DEFAULT_MODE=0

# USB
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_GENERIC=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_GENERIC=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_DWC3=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GENERIC=y

# 网络引导
CONFIG_BOOTCOMMAND="run loadbootcmd; run loadfdtcmd; run bootcmd"
CONFIG_LOADBOOTCMD="mmc dev 0 && print mmcinfo; ext2load mmc 0:1 ${loadaddr} /boot/uImage; ext2load mmc 0:1 ${fdt_addr_r} /boot/rk3568-evb-v11a.dtb; booti ${loadaddr} - ${fdt_addr_r}"
CONFIG_LOADFDTCMD="ext2load mmc 0:1 ${fdt_addr_r} /boot/rk3568-evb-v11a.dtb"
CONFIG_BOOTCMD="run loadbootcmd; run loadfdtcmd; run bootcmd"

# 环境变量
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_SIZE=0x40000
CONFIG_ENV_SECT_SIZE=0x20000

# 调试
CONFIG_DEBUG_UART_BASE=0x90002000
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_DEBUG_UART=y

# 打印信息
CONFIG_SYS_CONSOLE_INFO_QUIET=n
