# ========================================
# ImmortalWrt v25.12.1 NanoPi R3S 极简精简版配置
# Target: Rockchip RK3566 / NanoPi R3S
# 精简插件: OpenClash, Tailscale, ttyd (网页终端), LuCI 简体中文
# ========================================

# 目标架构与板型选择 (NanoPi R3S / RK3566)
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r3s=y

# 镜像格式 (SquashFS + Ext4 双生成)
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 核心系统与基础依赖
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_unzip=y

# Web 界面 (LuCI + 经典 Lua 兼容层 + 简体中文)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# 1. 代理与分流: OpenClash
CONFIG_PACKAGE_luci-app-openclash=y

# 2. 异地组网: Tailscale + WireGuard
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# 3. 网页终端: ttyd
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# 极简瘦身: 显式剔除不需要的大型服务
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_appfilter is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
